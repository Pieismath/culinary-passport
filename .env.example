# Leave blank (or delete this file) to run in local demo mode.
# Fill both to switch the app to Supabase mode — see README for setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Recommended: Google Places API key — the preferred provider for restaurant
# autocomplete + nearby search (ratings, place_id, coordinates). See README
# "Google Places setup". Leave blank to fall back to free OpenStreetMap data.
VITE_GOOGLE_PLACES_API_KEY=
